<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>ปริ้นป้ายราคา</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700;800&family=Kanit:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --red:#E30613; --red-d:#B8050F; --ink:#1B2420; --muted:#7A847F; --line:#E6E9E7; --bg:#F4F5F4; --green:#06C755; }
  * { box-sizing: border-box; margin: 0; }
  html, body { background: var(--bg); color: var(--ink); font-family: "Sarabun", system-ui, sans-serif; }
  body { padding-bottom: 150px; }
  header { background: var(--red); color: #fff; padding: 16px; }
  header h1 { font-size: 20px; font-weight: 800; }
  header p { font-size: 13px; opacity: .9; margin-top: 2px; }
  .badge { display: inline-block; margin-top: 8px; background: rgba(255,255,255,.18); border-radius: 20px; padding: 3px 12px; font-size: 13px; font-weight: 700; }
  main { padding: 14px 16px; max-width: 680px; margin: 0 auto; }
  .card { background: #fff; border-radius: 14px; padding: 14px; margin-bottom: 12px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .card h2 { font-size: 14px; color: var(--muted); font-weight: 600; margin-bottom: 10px; }
  button { font: inherit; font-weight: 700; border: 0; border-radius: 10px; cursor: pointer; }
  input { font: inherit; }

  /* เพิ่มสินค้า */
  .row { display: flex; gap: 8px; }
  #code { flex: 1; min-width: 0; border: 1.5px solid var(--line); border-radius: 10px; padding: 11px 12px; font-size: 17px; }
  #code:focus { outline: none; border-color: var(--red); }
  #add { background: var(--red); color: #fff; padding: 0 18px; font-size: 16px; }
  #camBtn { width: 100%; margin-top: 8px; background: #FDECEC; color: var(--red-d); padding: 11px; font-size: 15px; }
  #cam { display: none; margin-top: 8px; border-radius: 12px; overflow: hidden; background: #000; }
  #cam.on { display: block; }
  #msg { font-size: 13px; color: var(--muted); margin-top: 8px; min-height: 18px; }
  #msg.ok { color: #0A8F43; } #msg.err { color: var(--red-d); }

  /* รายการป้าย */
  #list { display: grid; gap: 10px; }
  .it { border: 1.5px solid var(--line); border-radius: 12px; padding: 10px; display: grid; grid-template-columns: 112px 1fr; gap: 10px; }
  .it.fresh { animation: fresh 1.2s ease; }
  @keyframes fresh { from { background: #FFF3C4; } to { background: #fff; } }
  .it canvas { width: 112px; height: 79px; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,.18); }
  .it .f { min-width: 0; display: grid; gap: 5px; }
  .it .top { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
  .it .top b { color: var(--ink); }
  .it .top .x { margin-left: auto; background: none; color: var(--muted); font-size: 18px; padding: 0 4px; }
  .it input { width: 100%; border: 1.5px solid var(--line); border-radius: 8px; padding: 6px 8px; font-size: 14px; }
  .it input:focus { outline: none; border-color: var(--red); }
  .it .pr { display: flex; gap: 6px; align-items: center; }
  .it .pr input { font-size: 18px; font-weight: 800; color: var(--red-d); width: 0; flex: 1; }
  .it .pr .was { font-size: 11px; color: var(--muted); white-space: nowrap; }
  .step { display: flex; align-items: center; border: 1.5px solid var(--line); border-radius: 8px; overflow: hidden; flex: none; }
  .step button { background: #fff; width: 28px; height: 32px; font-size: 17px; color: var(--ink); border-radius: 0; }
  .step b { min-width: 22px; text-align: center; font-size: 14px; }
  .empty { color: var(--muted); font-size: 14px; padding: 18px 0; text-align: center; }

  /* ตั้งค่า */
  .seg { display: flex; background: var(--bg); border-radius: 10px; padding: 3px; }
  .seg button { flex: 1; background: none; color: var(--muted); padding: 9px 4px; font-size: 15px; }
  .seg button.on { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .seg button small { display: block; font-size: 10.5px; line-height: 1.25; font-weight: 500; color: var(--muted); }
  .lbl { font-size: 12px; color: var(--muted); margin: 12px 0 6px; }
  #label { width: 100%; border: 1.5px solid var(--line); border-radius: 10px; padding: 9px 12px; font-size: 15px; }
  .chips { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
  .chips button { background: var(--bg); color: var(--ink); font-size: 13px; padding: 5px 10px; font-weight: 600; }

  /* ตัวอย่าง */
  #pv { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 2px 10px; }
  #pv .pg { flex: none; scroll-snap-align: center; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.18); position: relative; display: grid; overflow: hidden; }
  #pv .pg img { width: 100%; height: 100%; display: block; object-fit: fill; }
  #pv .pg .cell { overflow: hidden; display: flex; }
  #pv .pg.a6 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  #pv .pg.a6 .cell:nth-child(odd) { border-right: 1.5px dashed #bbb; }
  #pv .pg.a6 .cell:nth-child(-n+2) { border-bottom: 1.5px dashed #bbb; }
  #pv .pg.a5 { grid-template-rows: 1fr 1fr; }
  #pv .pg.a5 .cell:first-child { border-bottom: 1.5px dashed #bbb; }
  #pv .pg .tag { position: absolute; left: 6px; top: 6px; background: rgba(0,0,0,.6); color: #fff; font-size: 11px; border-radius: 6px; padding: 1px 6px; }
  .hint { font-size: 12px; color: var(--muted); }

  /* ค้นชื่อ */
  #find { position: fixed; inset: 0; z-index: 50; background: rgba(15,20,18,.55); display: none; align-items: flex-end; }
  #find.on { display: flex; }
  #find .sh { background: #fff; width: 100%; max-height: 85vh; border-radius: 18px 18px 0 0; padding: 14px 16px 20px; display: flex; flex-direction: column; }
  #find .hd2 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  #find .hd2 b { font-size: 17px; }
  #find .hd2 button { background: none; font-size: 22px; color: var(--muted); }
  #q { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 16px; width: 100%; }
  #res { overflow-y: auto; margin-top: 8px; }
  #res button { display: block; width: 100%; text-align: left; background: none; border-top: 1px solid var(--line); border-radius: 0; padding: 10px 2px; font-weight: 500; font-size: 15px; }
  #res button small { color: var(--muted); display: block; font-size: 12px; }
  #res .note { color: var(--muted); font-size: 13px; padding: 12px 0; }

  #bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 10px 16px 14px; box-shadow: 0 -2px 10px rgba(0,0,0,.08); display: flex; gap: 10px; align-items: center; z-index: 20; }
  #bar .info { flex: 1; font-size: 13px; color: var(--muted); }
  #bar .info b { color: var(--ink); font-size: 15px; }
  #print { background: var(--red); color: #fff; padding: 13px 22px; font-size: 16px; }
  #print:disabled { opacity: .4; }
  #pst { position: fixed; inset: 0; z-index: 60; background: rgba(15,20,18,.6); display: none; align-items: center; justify-content: center; padding: 24px; }
  #pst.on { display: flex; }
  #pst .box { background: #fff; border-radius: 18px; padding: 24px 20px; width: 100%; max-width: 360px; text-align: center; }
  #pst .ic { font-size: 54px; line-height: 1.1; display: inline-block; }
  #pst .ic.spin { animation: spin 1.2s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #pst h3 { font-size: 20px; margin: 8px 0 4px; }
  #pst p { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
  #pst .btns { display: grid; gap: 8px; }
  #pst .btns button { padding: 12px; font-size: 16px; background: var(--red); color: #fff; }
  #pst .btns button.ghost { background: #FDECEC; color: var(--red-d); }
</style>
</head>
<body>
  <header>
    <h1>🏷️ ปริ้นป้ายราคา</h1>
    <p>ใส่รหัสสินค้า → ระบบทำป้ายให้ → สั่งปริ้น</p>
    <span class="badge" id="badge">🖨️ ออกที่เครื่อง ALC (สี)</span>
  </header>

  <main>
    <section class="card">
      <h2>1. เพิ่มสินค้า</h2>
      <div class="row">
        <input id="code" inputmode="search" placeholder="รหัสสินค้า / บาร์โค้ด / ชื่อ" autocomplete="off">
        <button id="add">เพิ่ม</button>
      </div>
      <button id="camBtn">📷 เปิดกล้องสแกน</button>
      <div id="cam"><div id="reader"></div></div>
      <div id="msg"></div>
    </section>

    <section class="card">
      <h2>2. ป้ายที่จะปริ้น <span id="cnt"></span></h2>
      <div id="list"><div class="empty">ยังไม่มีสินค้า — สแกนหรือพิมพ์รหัสด้านบน</div></div>
      <div class="lbl">ข้อความใต้ราคา (ทุกป้าย)</div>
      <input id="label" value="ราคาพิเศษ" maxlength="40">
      <div class="chips"><button data-l="ราคาพิเศษ">ราคาพิเศษ</button><button data-l="ราคาปกติ">ราคาปกติ</button><button data-l="ราคาต่อกิโลกรัม">ราคาต่อกิโลกรัม</button><button data-l="">ไม่ใส่</button></div>
    </section>

    <section class="card">
      <h2>3. ขนาดกระดาษ</h2>
      <div class="seg" id="paper">
        <button data-v="A6">A6<small>4 ป้าย / A4</small></button>
        <button data-v="A5" class="on">A5<small>2 ป้าย / A4</small></button>
        <button data-v="A4">A4<small>1 ป้าย</small></button>
        <button data-v="A3">A3<small>ใหญ่</small></button>
      </div>
    </section>

    <section class="card">
      <h2>4. ตัวอย่างก่อนปริ้น <span id="pvCount"></span></h2>
      <div id="pv"><div class="empty" style="width:100%">ยังไม่มีป้าย</div></div>
      <div class="hint">ปัดซ้าย-ขวาเพื่อดูแต่ละแผ่น</div>
    </section>
  </main>

  <div id="bar">
    <div class="info"><b id="sum">0 แผ่น</b><br><span id="sum2">A5 · เครื่อง ALC</span></div>
    <button id="print" disabled>🖨️ สั่งปริ้น</button>
  </div>

  <div id="find"><div class="sh">
    <div class="hd2"><b>🔎 ค้นหาสินค้า</b><button id="fClose">✕</button></div>
    <input id="q" placeholder="พิมพ์ชื่อ เช่น ข้าวหอม 5กก" autocomplete="off">
    <div id="res"></div>
  </div></div>

  <div id="pst"><div class="box"><div class="ic" id="pIc">🖨️</div><h3 id="pT"></h3><p id="pD"></p><div class="btns" id="pBtns"></div></div></div>

  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    // ===== ตั้งค่า =====
    const DEST = 'ALC';      // เครื่องที่ปริ้น (สี)
    const LIFF_ID = '';      // ใส่ทีหลังเมื่อทำ LIFF ให้หน้านี้
    const API_URL = 'https://script.google.com/macros/s/AKfycbz9kcxmlb75jV1hT0dgtavyJYoEYo7p0fpsVtvBsw-aHuhS3fNC_YoGUXmNfHBi_1-O/exec';
    const BG_URL = 'sign_bg.jpg';   // แบบป้ายของส่วนกลาง (วางไว้ข้าง ๆ ไฟล์นี้ใน GitHub)
    const W = 2480, H = 1754;       // ขนาดรูปป้ายที่ส่งไปปริ้น (สัดส่วนกระดาษ A แนวนอน)
    // ===================

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let signs = [], paper = 'A5', me = '', uid = '', busy = false, scanner = null, cand = '', candAt = 0, lastScan = '', lastAt = 0;
    try { signs = JSON.parse(localStorage.getItem('price137_list') || '[]'); } catch (e) {}
    try { const l = localStorage.getItem('price137_label'); if (l !== null) $('label').value = l; } catch (e) {}
    try { paper = localStorage.getItem('price137_paper') || 'A5'; } catch (e) {}
    const save = () => { try { localStorage.setItem('price137_list', JSON.stringify(signs.map(s => ({ ...s, fresh: false })))); } catch (e) {} };

    // ---------- วาดป้าย ----------
    const bg = new Image();
    const ready = new Promise(ok => { bg.onload = ok; bg.onerror = ok; });
    bg.src = BG_URL;
    const fontsReady = Promise.all([
      document.fonts.load('500 100px Kanit', 'ราคา0'), document.fonts.load('600 100px Kanit', '0'),
      document.fonts.load('400 100px Kanit', 'ราคา'),
    ]).catch(() => {});

    function priceParts(p) {
      const n = Math.round((Number(p) || 0) * 100) / 100;
      const [a, b] = n.toFixed(2).split('.');
      return [Number(a).toLocaleString('en-US'), '.' + b];
    }

    // ตัวหนังสือยาวเกินกว่าที่ให้ → ย่อขนาดลงจนพอดี
    function fitFont(g, text, weight, size, maxW, family) {
      let s = size;
      g.font = `${weight} ${s}px ${family}`;
      while (g.measureText(text).width > maxW && s > size * 0.35) { s -= size * 0.03; g.font = `${weight} ${s}px ${family}`; }
      return s;
    }

    // ตำแหน่งต่าง ๆ เทียบกับขนาดป้าย (วัดจากป้ายจริงที่ส่วนกลางใช้)
    function drawSign(c, s, label) {
      const g = c.getContext('2d'), w = c.width, h = c.height, K = 'Kanit, Sarabun, sans-serif';
      g.clearRect(0, 0, w, h);
      if (bg.naturalWidth) g.drawImage(bg, 0, 0, w, h); else { g.fillStyle = '#fff'; g.fillRect(0, 0, w, h); }
      const x0 = w * 0.115, maxW = w * 0.83;
      g.textBaseline = 'alphabetic';
      g.fillStyle = '#2A2A2A';
      g.font = `400 ${h * 0.034}px ${K}`;
      g.fillText('รหัสสินค้า : ' + (s.item || ''), x0, h * 0.205);

      g.fillStyle = '#111';
      fitFont(g, s.desc || '', 500, h * 0.078, maxW, K);
      g.fillText(s.desc || '', x0, h * 0.305);

      if (s.en) {
        g.fillStyle = '#444';
        fitFont(g, s.en, 400, h * 0.03, maxW, K);
        g.fillText(s.en, x0, h * 0.37);
      }

      const [big, dec] = priceParts(s.price);
      const px = w * 0.19, base = h * 0.705;
      let bs = h * 0.34;
      g.font = `500 ${bs}px ${K}`;
      const ds = () => bs * 0.42;
      const total = () => { g.font = `500 ${bs}px ${K}`; const a = g.measureText(big).width; g.font = `500 ${ds()}px ${K}`; return a + bs * 0.04 + g.measureText(dec).width; };
      while (total() > w * 0.74 && bs > h * 0.15) bs -= h * 0.01;        // ราคาหลักพัน/หมื่น ย่อให้พอดี
      g.fillStyle = '#D3202A';
      g.font = `500 ${bs}px ${K}`;
      g.fillText(big, px, base);
      const bw = g.measureText(big).width;
      g.font = `500 ${ds()}px ${K}`;
      g.fillText(dec, px + bw + bs * 0.04, base);

      if (label) {
        g.fillStyle = '#2A2A2A';
        g.font = `400 ${h * 0.034}px ${K}`;
        g.fillText(label, x0, h * 0.8);
      }
    }

    function signCanvas(s, scale) {
      const c = document.createElement('canvas');
      c.width = Math.round(W * scale); c.height = Math.round(H * scale);
      drawSign(c, s, $('label').value.trim());
      return c;
    }

    // ---------- หน้าจอ ----------
    function renderList() {
      $('cnt').textContent = signs.length ? `(${signs.length} รายการ)` : '';
      if (!signs.length) { $('list').innerHTML = '<div class="empty">ยังไม่มีสินค้า — สแกนหรือพิมพ์รหัสด้านบน</div>'; return; }
      $('list').innerHTML = signs.map((s, i) => `<div class="it${s.fresh ? ' fresh' : ''}" data-i="${i}">
          <canvas width="448" height="317"></canvas>
          <div class="f">
            <div class="top">รหัส <b>${esc(s.item)}</b><button class="x" data-del="${i}">✕</button></div>
            <input data-k="desc" value="${esc(s.desc)}" placeholder="ชื่อสินค้า (ไทย)">
            <input data-k="en" value="${esc(s.en || '')}" placeholder="ชื่อภาษาอังกฤษ (ไม่ใส่ก็ได้)">
            <div class="pr"><input data-k="price" inputmode="decimal" value="${s.price || ''}" placeholder="ราคา">
              ${s.sys ? `<span class="was">ในระบบ<br>${Number(s.sys).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>` : ''}
              <div class="step"><button data-cp="-1">−</button><b>${s.copies || 1}</b><button data-cp="1">+</button></div></div>
          </div></div>`).join('');
      signs.forEach((s, i) => { s.fresh = false; drawThumb(i); });
    }
    function drawThumb(i) {
      const c = $('list').querySelector(`.it[data-i="${i}"] canvas`);
      if (c) drawSign(c, signs[i], $('label').value.trim());
    }

    function slots() { const out = []; signs.forEach(s => { for (let k = 0; k < (s.copies || 1); k++) out.push(s); }); return out; }
    const PER = { A6: 4, A5: 2, A4: 1, A3: 1 };

    let pvTimer = 0;
    function renderPreview() {
      clearTimeout(pvTimer);
      pvTimer = setTimeout(() => {
        const sl = slots(), per = PER[paper], sheets = Math.ceil(sl.length / per);
        const Hh = 230, A4W = Math.round(Hh * 210 / 297);
        let html = '';
        const urls = new Map();
        const url = (s, rot) => { const k = signs.indexOf(s) + (rot ? 'r' : ''); if (!urls.has(k)) urls.set(k, thumbURL(s, rot)); return urls.get(k); };
        for (let i = 0; i < sl.length && i < 120; i += per) {
          const grp = sl.slice(i, i + per), no = i / per + 1;
          if (per === 1) {   // A4/A3: ป้ายแนวนอน 1 แผ่น
            html += `<div class="pg" style="width:${Hh}px;height:${A4W}px"><img src="${url(grp[0])}"><span class="tag">${paper} แผ่นที่ ${no}</span></div>`;
          } else {
            const cells = Array.from({ length: per }, (_, k) => `<div class="cell">${grp[k] ? `<img src="${url(grp[k], per === 4)}">` : ''}</div>`).join('');
            html += `<div class="pg ${paper.toLowerCase()}" style="width:${A4W}px;height:${Hh}px">${cells}<span class="tag">A4 แผ่นที่ ${no} · ${per} ป้าย ${paper}</span></div>`;
          }
        }
        $('pv').innerHTML = html || '<div class="empty" style="width:100%">ยังไม่มีป้าย</div>';
        $('pvCount').textContent = sl.length ? `(${sheets} แผ่น${per > 1 ? ' A4' : ''} · ${sl.length} ป้าย)` : '';
        $('sum').textContent = sheets + ' แผ่น · ' + sl.length + ' ป้าย';
        $('sum2').textContent = ({ A6: 'A6 (4 ป้าย/A4)', A5: 'A5 (2 ป้าย/A4)' }[paper] || paper) + ' · เครื่อง ' + DEST;
        $('print').disabled = !sl.length;
      }, 120);
    }
    function thumbURL(s, rot) {
      const c = signCanvas(s, 0.2);
      if (!rot) return c.toDataURL('image/jpeg', .8);
      const r = document.createElement('canvas'); r.width = c.height; r.height = c.width;   // ช่อง A6 แนวตั้ง → หมุนป้าย (เหมือนตอนปริ้นจริง)
      const g = r.getContext('2d'); g.translate(r.width, 0); g.rotate(Math.PI / 2); g.drawImage(c, 0, 0);
      return r.toDataURL('image/jpeg', .8);
    }
    function render() { renderList(); renderPreview(); save(); }

    // ---------- ค้นหาสินค้า ----------
    function say(t, cls) { $('msg').textContent = t; $('msg').className = cls || ''; }

    function pushSign(r) {
      if (signs.some(s => s.item === r.item)) { say(r.item + ' มีในรายการแล้ว', 'err'); return; }
      signs.unshift({ item: r.item, desc: r.desc, en: '', price: r.price || '', sys: r.price || 0, copies: 1, fresh: true });
      if (navigator.vibrate) navigator.vibrate(60);
      say(r.price ? `✓ ${r.item} ${r.desc} · ${r.price} บาท` : `✓ ${r.item} — ไม่มีราคาในระบบ กรอกราคาเองนะครับ`, r.price ? 'ok' : 'err');
      render();
    }

    async function add(raw) {
      const text = String(raw || '').trim();
      if (!text || busy) return;
      if (/\D/.test(text.replace(/\s/g, ''))) { openFind(text); return; }
      const code = text.replace(/\D/g, '');
      busy = true; say('กำลังค้นหา ' + code + ' …');
      try {
        const r = await (await fetch(API_URL + '?action=price&code=' + encodeURIComponent(code))).json();
        if (r.error) { say('ไม่พบ ' + code + ' — ลองค้นจากชื่อ', 'err'); if (navigator.vibrate) navigator.vibrate([60, 60, 60]); return; }
        $('code').value = '';
        pushSign(r);
      } catch (e) { say('เชื่อมต่อไม่ได้: ' + (e.message || e), 'err'); }
      finally { busy = false; }
    }

    function openFind(text) { $('find').classList.add('on'); $('q').value = text || ''; $('res').innerHTML = ''; if (text) doSearch(); setTimeout(() => $('q').focus(), 50); }
    async function doSearch() {
      const q = $('q').value.trim(); if (!q) return;
      $('res').innerHTML = '<div class="note">กำลังค้นหา…</div>';
      try {
        const r = await (await fetch(API_URL + '?action=search&q=' + encodeURIComponent(q))).json();
        const list = r.results || [];
        $('res').innerHTML = list.length ? list.map(x => `<button data-it="${esc(x.item)}">${esc(x.desc)}<small>${esc(x.item)}${x.status && x.status !== 'Active' ? ' · ' + esc(x.status) : ''}</small></button>`).join('')
          : '<div class="note">ไม่พบ — ลองคำอื่น</div>';
      } catch (e) { $('res').innerHTML = '<div class="note">เชื่อมต่อไม่ได้</div>'; }
    }
    $('q').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    $('fClose').onclick = () => $('find').classList.remove('on');
    $('res').onclick = e => { const b = e.target.closest('button[data-it]'); if (!b) return; $('find').classList.remove('on'); add(b.dataset.it); };

    async function toggleCam() {
      if (scanner) { try { await scanner.stop(); } catch (e) {} scanner = null; $('cam').classList.remove('on'); $('camBtn').textContent = '📷 เปิดกล้องสแกน'; return; }
      $('cam').classList.add('on'); $('camBtn').textContent = '⏹ ปิดกล้อง';
      const F = Html5QrcodeSupportedFormats;
      scanner = new Html5Qrcode('reader', { formatsToSupport: [F.EAN_13, F.EAN_8, F.UPC_A, F.UPC_E, F.CODE_128, F.CODE_39, F.ITF],
        experimentalFeatures: { useBarCodeDetectorIfSupported: true }, verbose: false });
      try {
        await scanner.start({ facingMode: 'environment' }, { fps: 12 }, (t) => {
          const now = Date.now();
          if (t !== cand || now - candAt > 1500) { cand = t; candAt = now; return; }   // อ่านได้เลขเดิม 2 ครั้งก่อน กันอ่านเพี้ยน
          if (t === lastScan && now - lastAt < 2500) return;
          lastScan = t; lastAt = now; cand = ''; add(t);
        }, () => {});
      } catch (e) { say('เปิดกล้องไม่ได้ — พิมพ์รหัสแทนได้', 'err'); scanner = null; $('cam').classList.remove('on'); $('camBtn').textContent = '📷 เปิดกล้องสแกน'; }
    }

    // ---------- ปุ่มต่าง ๆ ----------
    $('add').onclick = () => add($('code').value);
    $('code').addEventListener('keydown', e => { if (e.key === 'Enter') add($('code').value); });
    $('camBtn').onclick = toggleCam;
    $('list').addEventListener('input', e => {
      const inp = e.target.closest('input[data-k]'); if (!inp) return;
      const i = +inp.closest('.it').dataset.i, k = inp.dataset.k;
      signs[i][k] = k === 'price' ? inp.value.replace(/[^\d.]/g, '') : inp.value;
      drawThumb(i); renderPreview(); save();
    });
    $('list').addEventListener('click', e => {
      const d = e.target.closest('[data-del]'); if (d) { signs.splice(+d.dataset.del, 1); render(); return; }
      const c = e.target.closest('[data-cp]'); if (c) { const i = +c.closest('.it').dataset.i; signs[i].copies = Math.max(1, Math.min(50, (signs[i].copies || 1) + +c.dataset.cp)); render(); }
    });
    $('label').addEventListener('input', () => { try { localStorage.setItem('price137_label', $('label').value); } catch (e) {} signs.forEach((s, i) => drawThumb(i)); renderPreview(); });
    document.querySelector('.chips').onclick = e => { const b = e.target.closest('button'); if (!b) return; $('label').value = b.dataset.l; $('label').dispatchEvent(new Event('input')); };
    $('paper').onclick = e => {
      const b = e.target.closest('button'); if (!b) return;
      paper = b.dataset.v; try { localStorage.setItem('price137_paper', paper); } catch (e) {}
      [...$('paper').children].forEach(x => x.classList.toggle('on', x === b)); renderPreview();
    };

    // ---------- สั่งปริ้น (ส่งเป็นรูปป้ายเข้าคิวเดียวกับป้ายโปรโมชั่น) ----------
    function pst(icon, title, desc, buttons, spin) {
      $('pIc').textContent = icon; $('pIc').className = 'ic' + (spin ? ' spin' : '');
      $('pT').textContent = title; $('pD').textContent = desc;
      $('pBtns').innerHTML = ''; (buttons || []).forEach(([t, fn, ghost]) => { const b = document.createElement('button'); b.textContent = t; if (ghost) b.className = 'ghost'; b.onclick = fn; $('pBtns').appendChild(b); });
      $('pst').classList.add('on');
    }
    const pstClose = () => $('pst').classList.remove('on');

    async function sendPrint() {
      const bad = signs.find(s => !(Number(s.price) > 0) || !String(s.desc).trim());
      if (bad) { pst('✏️', 'ข้อมูลยังไม่ครบ', `รหัส ${bad.item} ยังไม่มีชื่อหรือราคา`, [['ตกลง', pstClose]]); return; }
      const sl = slots(), per = PER[paper];
      pst('⏳', 'กำลังทำป้าย…', `${signs.length} รายการ · ${sl.length} ป้าย → ${DEST}`, [], true);
      let r;
      try {
        await ready; await fontsReady;
        const list = signs.map(s => ({ name: s.item + '.jpg', mime: 'image/jpeg', copies: s.copies || 1,
          data: signCanvas(s, 1).toDataURL('image/jpeg', .92).split(',')[1] }));
        const txt = await (await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'promo', dest: DEST, paper, fit: 'stretch', files: list, by: me, uid, lineName: me }) })).text();
        try { r = JSON.parse(txt); } catch (e) { r = { error: 'Google ตอบกลับไม่ถูกต้อง — โค้ดบอทอาจยังไม่ได้ Deploy เวอร์ชันใหม่' }; }
      } catch (e) { r = { error: 'ส่งงานไม่สำเร็จ (' + (e.message || e) + ')' }; }
      if (r.error === 'no_permission') { pst('🔒', 'ยังไม่มีสิทธิ์ปริ้น', 'แจ้ง admin ให้เปิดสิทธิ์ก่อนนะครับ', [['ปิด', pstClose]]); return; }
      if (r.error) { pst('⚠️', 'ส่งงานไม่สำเร็จ', r.error, [['ลองอีกครั้ง', sendPrint], ['ปิด', pstClose, true]]); return; }

      const sheets = Math.ceil(sl.length / per);
      pst('🖨️', 'ส่งงานแล้ว รอเครื่องปริ้น…', `${DEST} · ${sheets} แผ่น`, [['ปิด (ไปทำอย่างอื่นได้)', pstClose, true]], true);
      const t0 = Date.now();
      while (Date.now() - t0 < 120000 && $('pst').classList.contains('on')) {
        await new Promise(res => setTimeout(res, 2500));
        let st; try { st = await (await fetch(API_URL + '?action=job&id=' + encodeURIComponent(r.id))).json(); } catch (e) { continue; }
        if (st.status === 'printed') {
          if (navigator.vibrate) navigator.vibrate([80, 60, 80]);
          pst('✅', 'ปริ้นแล้ว', `ไปรับป้ายที่เครื่อง ${DEST} ได้เลย`, [['🏷️ ทำป้ายชุดใหม่', () => { signs = []; pstClose(); render(); }], ['ปิด (เก็บรายการไว้)', pstClose, true]]); return;
        }
        if (st.status === 'failed') { pst('⚠️', 'ปริ้นไม่สำเร็จ', st.note || 'เครื่องปริ้นมีปัญหา', [['ลองอีกครั้ง', sendPrint], ['ปิด', pstClose, true]]); return; }
        if (st.status === 'waiting' && st.agentOnline === false && Date.now() - t0 > 15000) {
          pst('💤', 'คอม GR ไม่ได้เปิดโปรแกรมปริ้น', 'งานรออยู่ในคิว จะปริ้นออกเมื่อคอม GR เปิดโปรแกรม', [['ปิด', pstClose]]); return;
        }
      }
      if ($('pst').classList.contains('on')) pst('⌛', 'ยังไม่ได้รับผลจากเครื่องปริ้น', 'งานอยู่ในคิวแล้ว ลองไปดูที่เครื่องปริ้น', [['ปิด', pstClose]]);
    }
    $('print').onclick = () => { if (signs.length) sendPrint(); };

    // ---------- เริ่ม ----------
    $('badge').textContent = '🖨️ ออกที่เครื่อง ' + DEST + (DEST === 'ALC' ? ' (สี)' : '');
    [...$('paper').children].forEach(x => x.classList.toggle('on', x.dataset.v === paper));
    (async () => {
      if (LIFF_ID && window.liff) {
        try { await liff.init({ liffId: LIFF_ID }); if (liff.isLoggedIn()) { const p = await liff.getProfile(); me = p.displayName; uid = p.userId; } } catch (e) {}
      }
    })();
    Promise.all([ready, fontsReady]).then(render);
    render();
  </script>
</body>
</html>
